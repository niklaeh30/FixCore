# ---- Discord ----
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=1538214452191826122
DEFAULT_ROLE_ID=1540798693123559474
REDEEM_CHANNEL_ID=1541012657740451860

# Channel where a message is posted every time someone redeems a key:
# who, when purchased, when redeemed, and which product/role. Set to 0 to disable.
REDEEM_LOG_CHANNEL_ID=1545436608856326165

# Always granted on top of whatever role a key resolves to — e.g. a
# general "Customer" role every buyer gets regardless of product.
# Set to 0 to disable.
EXTRA_ROLE_ID=1538255411298304010

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Maps a Stripe Price ID to a Discord role ID, as JSON.
# Any price not listed here falls back to DEFAULT_ROLE_ID.
PRODUCT_ROLE_MAP={"price_ABC123": 123456789012345678, "price_DEF456": 987654321098765432}

# ---- Misc ----
DATABASE_PATH=redeem.db
SUCCESS_PAGE_BASE_URL=https://fixcorepc.com
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000
BRAND_NAME=FixCore
PRODUCTS_URL=https://fixcorepc.com/products

# ---- FixCore Free Tweaks ----
# Role given when a free key is redeemed (create a "Free Tweaks" role in Discord).
# 0 = free keys switched off.
FREE_TWEAKS_ROLE_ID=0
# Link to the installer - only shown on the website after the key is redeemed.
FREE_TWEAKS_DOWNLOAD_URL=https://fixcorepc.com/FixCore_Free_Tweaks_Setup.exe
# Optional: shared secret so fixcore-accounts can request keys server-to-server.
FREE_KEY_API_SECRET=
# Websites allowed to call /api/ from the browser.
ALLOWED_ORIGINS=https://fixcorepc.com,https://www.fixcorepc.com
# FixCore account backend (email login) - used to check website logins.
ACCOUNTS_API_BASE=https://web-production-fae792.up.railway.app
