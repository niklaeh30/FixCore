# Copy this to .env locally, or set these as Railway environment variables.

# Random long secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_value

# Resend.com API key (free tier: 3,000 emails/month, 100/day)
# https://resend.com -> API Keys -> Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you've verified in Resend.
# Until you verify fixcorepc.com in Resend, you can only send to your
# own Resend account email — see README for the verification steps.
FROM_EMAIL=FixCore <accounts@fixcorepc.com>

# Comma-separated list of origins allowed to call this API from the browser
ALLOWED_ORIGINS=

# Where the SQLite database file lives (fine as-is for a small user base)
DATABASE_PATH=fixcore_accounts.db

STRIPE_SECRET_KEY=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